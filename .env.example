# ============================================================
# Smart Minds — Environment Variables
# Copy this file to server/.env and fill in your real values
# NEVER commit .env to GitHub
# ============================================================

# MongoDB Atlas Connection String
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.XXXXX.mongodb.net/smartminds

# JWT Secret — use a long random string (min 32 chars)
JWT_SECRET=replace_with_very_long_random_secret_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Gemini AI API Key (preferred for the app)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Anthropic Claude AI API Key (fallback)
# Get from: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY

# Google Maps API Key (optional — for real navigation)
# Get from: https://console.cloud.google.com
MAPS_API_KEY=
