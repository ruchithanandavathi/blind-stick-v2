# ============================================================
# Smart Minds — Server Environment Variables
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your real values below
# 3. NEVER commit .env to GitHub
# ============================================================

# MongoDB Atlas (get from cloud.mongodb.com)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.XXXXX.mongodb.net/smartminds

# JWT Secret — make this a long random string
JWT_SECRET=replace_this_with_a_very_long_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Server config
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Gemini AI API Key (preferred for the app)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Anthropic Claude AI (fallback if you prefer Claude)
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY

# Optional: Google Maps for real navigation
MAPS_API_KEY=
